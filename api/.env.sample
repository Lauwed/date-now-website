JWT_SECRET=
RESEND_API_KEY=
MAIL_FROM=
CORS_ORIGIN=
# Postgres connection string (Vercel Postgres / Neon) — use the direct
# (non-pooled) connection, not the PgBouncer-pooled one, since this API
# manages its own long-lived connections rather than serverless invocations.
DATABASE_URL=
# Base64-encoded 32-byte master key for User.email/User.totpSeed
# encryption at rest. Generate with: openssl rand -base64 32
DB_ENCRYPTION_KEY=
# Vercel Blob read/write token, used to upload/delete media files
# (api/src/lib/blob.c). Create a Blob store on Vercel and generate a
# read/write token from its Settings tab, or via `vercel blob store create`.
BLOB_READ_WRITE_TOKEN=
# Email validation (see README.md). All optional.
# EMAIL_VALIDATION_BYPASS=1   skip every check (CI, local development)
# EMAIL_DNS_CHECK=0           skip the DNS lookup
# EMAIL_BLOCKLIST_MODE=reject "reject" refuses a blocked domain, "flag" flags the user
# BLOCKED_DOMAIN_LIST_PUBLIC=1  anyone can read the blocklist
# The domain of the service: it cannot be used for an email
APP_DOMAIN=
